# Copy to .env (docker compose reads it automatically). All defaults work out of the box.

# --- Manufacturer identity (FACT fields in every report) ---
FRIST24_MANUFACTURER_NAME=Beispiel Maschinenbau GmbH
FRIST24_MANUFACTURER_CONTACT=psirt@beispiel-maschinenbau.example

# --- Database ---
POSTGRES_USER=frist24
POSTGRES_PASSWORD=frist24
POSTGRES_DB=frist24
DATABASE_URL=postgresql+psycopg://frist24:frist24@db:5432/frist24

# --- Local LLM ---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_FALLBACK_MODEL=mistral

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Feed sync ---
KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_CSV_URL=https://epss.cyentia.com/epss_scores-current.csv.gz
OSV_API_URL=https://api.osv.dev/v1
SYNC_INTERVAL_MINUTES=15
SYNC_ENABLED=true
